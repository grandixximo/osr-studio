<Page x:Class="OsrStudio.WebcamPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:osr="clr-namespace:OsrStudio"
      Title="{Binding WebCam, Source={StaticResource Loc}, Mode=OneWay}"
      DataContext="{Binding MainViewModel, Source={StaticResource ServiceLocator}}">
    <Grid Margin="5,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel DataContext="{Binding Settings.WebcamOverlay}">
            <DockPanel>
                <osr:ModernButton ToolTip="{Binding Refresh, Source={StaticResource Loc}, Mode=OneWay}"
                                      Command="{Binding WebcamModel.RefreshCommand, Source={StaticResource ServiceLocator}}"
                                      IconData="{Binding Icons.Refresh, Source={StaticResource ServiceLocator}}"
                                      DockPanel.Dock="Right"/>

                <osr:ModernButton ToolTip="Capture Image"
                                      Click="CaptureImage_OnClick"
                                      IconData="{Binding Icons.Camera, Source={StaticResource ServiceLocator}}"
                                      DockPanel.Dock="Right"/>

                <Path Data="{Binding Icons.Webcam, Source={StaticResource ServiceLocator}}"
                      Width="15"
                      Height="15"
                      Margin="0,0,7,0"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

                <Label Content="{Binding WebCam, Source={StaticResource Loc}, Mode=OneWay}"
                       FontWeight="Bold"/>
            </DockPanel>
            <ComboBox Margin="0,5"
                      ItemsSource="{Binding WebcamModel.AvailableCams, Source={StaticResource ServiceLocator}}"
                      SelectedValue="{Binding WebcamModel.SelectedCam, Mode=TwoWay, Source={StaticResource ServiceLocator}}"
                      Name="WebCamsComboBox"
                      IsEnabled="{Binding RecordingViewModel.RecorderState, Source={StaticResource ServiceLocator}, Converter={StaticResource NotRecordingConverter}}"/>

            <DockPanel Margin="0,5">
                <Label Content="{Binding Opacity, Source={StaticResource Loc}, Mode=OneWay}"
                       ContentStringFormat="{}{0}:"/>
                <Label Content="{Binding Opacity}"
                       ContentStringFormat="{}{0:N0}%"
                       Margin="5,0"
                       MinWidth="30"
                       HorizontalContentAlignment="Right"/>
                <Slider Minimum="1" 
                        Maximum="100"
                        Value="{Binding Opacity}"/>
            </DockPanel>
        </StackPanel>

        <GridSplitter Width="1"
                      Margin="5,0"
                      IsEnabled="False"
                      Grid.Column="1"/>

        <Grid Grid.Column="2">
            <osr:WebcamControl Margin="5"/>
        </Grid>
    </Grid>
</Page>
